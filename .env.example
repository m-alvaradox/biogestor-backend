# Copia este archivo a .env y ajusta los valores para tu equipo local.
# No uses estas credenciales de ejemplo fuera de desarrollo.

DJANGO_SECRET_KEY=django-insecure-local-only-change-before-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=biogestor
POSTGRES_USER=biogestor
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
